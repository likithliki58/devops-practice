pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git(
                    url: 'git@github.com:Likithsadhana/devops-practice.git',
                    credentialsId: 'github-ssh',
                    branch: 'main'
                )
            }
        }

        stage('Test') {
            steps {
                sh '''
                    python3 -m venv .jenkins-venv
                    . .jenkins-venv/bin/activate
                    pip install -r app/requirements.txt
                    pytest
                '''
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -f docker/Dockerfile -t devops-app:1.0 .'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker stop devops-app || true
                    docker rm devops-app || true
                    docker run -d \
                        --name devops-app \
                        -p 5000:5000 \
                        devops-app:1.0
                '''
            }
        }
    }
}
